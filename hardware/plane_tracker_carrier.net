    (comp (ref "J8") (value "Relay contacts COM/NO") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
    (comp (ref "J4") (value "Pi 40-pin socket") (footprint "Connector_PinSocket_2.54mm:PinSocket_2x20_P2.54mm_Vertical"))
    (comp (ref "J5") (value "PIR SR505") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"))
    (comp (ref "J6") (value "Encoder HW-040") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x05_P2.54mm_Vertical"))
    (comp (ref "C4") (value "100nF") (footprint "Capacitor_SMD:C_0805_2012Metric"))
    (comp (ref "C5") (value "100nF") (footprint "Capacitor_SMD:C_0805_2012Metric"))
    (comp (ref "J7") (value "Relay module header") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical"))
    (comp (ref "R1") (value "1k") (footprint "Resistor_SMD:R_0805_2012Metric"))
    (comp (ref "Q1") (value "BC337") (footprint "Package_TO_SOT_THT:TO-92_Inline"))
    (comp (ref "D2") (value "1N4148") (footprint "Diode_SMD:D_SOD-123"))
    (comp (ref "J9") (value "Relay coil (bare relay)") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm_Vertical"))
  )
  (nets
