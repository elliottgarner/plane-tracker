(export (version "E")
  (design (source "plane_tracker_carrier") (date "2026-10-28") (tool "make_kicad_netlist.py"))
  (components
    (comp (ref "J1") (value "Barrel jack 12V") (footprint "Connector_BarrelJack:BarrelJack_Horizontal"))
    (comp (ref "F1") (value "2A PTC") (footprint "Fuse:Fuse_1812_4532Metric"))
    (comp (ref "D1") (value "SMBJ15A") (footprint "Diode_SMD:D_SMB"))
    (comp (ref "C1") (value "100uF 25V") (footprint "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm"))
