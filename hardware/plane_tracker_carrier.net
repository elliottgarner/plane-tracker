    (comp (ref "U2") (value "Buck module (display, 5.0V)") (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical"))
    (comp (ref "C2") (value "100uF 10V") (footprint "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm"))
    (comp (ref "C3") (value "100uF 10V") (footprint "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm"))
    (comp (ref "J2") (value "To Pi USB-C power") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
    (comp (ref "J3") (value "To display 5V") (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm"))
